{
  "name": "hetu",
  "private": true,
  "workspaces": [
    "apps/website",
    "apps/task-view",
    "packages/npm-cli",
    "apps/desktop",
    "packages/plugin-sdk",
    "packages/plugin-host",
    "packages/workbench-ui"
  ],
  "engines": {
    "node": ">=24.21.0 <26"
  },
  "scripts": {
    "dev": "npm run dev --workspace @hetu/website",
    "build": "npm run build --workspace @hetu/website",
    "check": "npm run check --workspace @hetu/website",
    "deploy:website": "npm run deploy --workspace @hetu/website",
    "build:task-view": "npm run build --workspace @hetu/task-view",
    "test:task-view": "npm run test --workspace @hetu/task-view",
    "test:cli": "npm run test --workspace @limecloud/hetu",
    "build:desktop": "npm run build --workspace @hetu/desktop",
    "start:desktop": "npm run start --workspace @hetu/desktop",
    "package:desktop": "npm run package:dev --workspace @hetu/desktop --",
    "test:plugins": "npm run test --workspace @hetu/desktop"
  },
  "version": "0.13.10"
}
