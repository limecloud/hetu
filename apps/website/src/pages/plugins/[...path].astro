---
import Plugins from '../../components/Plugins.astro';
import { plugins } from '../../lib/plugins';
export function getStaticPaths() { return [{ params: { path: undefined } }, ...plugins.map(plugin => ({ params: { path: plugin.slug }, props: { plugin } }))]; }
---
<Plugins locale="zh-CN" plugin={Astro.props.plugin}/>
