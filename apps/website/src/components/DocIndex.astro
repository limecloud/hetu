---
import { orderedDocs, groups, sectionPath, sectionContent } from '../lib/docs';
import { messages, route, prototype, type Locale } from '../lib/site';
import DocsNavigation from './DocsNavigation.astro';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const m = messages(locale), en = locale === 'en';
const paths = en ? [
  { title: 'Write a novel', text: 'Start with an idea or a draft. Develop an outline, write a chapter and decide what to keep.', href: 'writing', links: [['Plan a book', 'codex-first-task'], ['Import a manuscript', 'import-manuscript']], icon: 'novel' },
  { title: 'Develop a screenplay', text: 'Create an original story or adapt a source. Read full scenes, action and dialogue.', href: 'screenplays', links: [['Adapt a novel', 'adaptation'], ['Give feedback', 'feedback']], icon: 'screenplay' },
  { title: 'Make a video', text: 'Try the rhythm in a preview. Review real picture and sound, then deliver an editable project.', href: 'video', links: [['Prepare assets', 'characters-and-scenes'], ['Deliver your work', 'formats-and-delivery']], icon: 'video' },
] : [
  { title: '写一本小说', text: '从一个点子或一份旧稿出发，讨论大纲，写出下一章，再决定留下哪些文字。', href: 'writing', links: [['构思一本新书', 'codex-first-task'], ['导入已有小说', 'import-manuscript']], icon: 'novel' },
  { title: '开发一部剧本', text: '原创或改编都从故事开始，读完整场次、行动与对白，沿同一集继续推敲。', href: 'screenplays', links: [['从小说到短剧', 'adaptation'], ['提出修改意见', 'feedback']], icon: 'screenplay' },
  { title: '制作一段视频', text: '先用预演判断节奏，再核对真实画面、声音与字幕，交出能继续编辑的工程。', href: 'video', links: [['准备人物与场景', 'characters-and-scenes'], ['交付成片与工程', 'formats-and-delivery']], icon: 'video' },
];
---
<DocsNavigation locale={locale}/>
<div class="container subpage help-index">
  <header class="page-hero docs-index-hero"><h1>{en ? 'Create with Hetu' : '河图洛书使用文档'}</h1><p>{en ? 'From a story idea to a manuscript, a screenplay or a finished video. Give your Agent a goal. Come back to read, watch and make it yours.' : '从一个故事念头，到小说、剧本与成片。向 Agent 说出目标，回来阅读与观看，把成果改成你想要的样子。'}</p><div class="docs-index-actions"><a class="button primary" href={route(locale, 'docs/getting-started')}>{en ? 'Quick start' : '快速入门'} <span aria-hidden="true">→</span></a><a class="text-link" href={prototype(locale)}>{en ? 'Explore the desktop preview' : '查看桌面界面预览'} ↗</a></div></header>
  <div class="docs-paths">{paths.map(path => <section>
    <svg class="docs-path-icon" width="28" height="28" viewBox="0 0 24 24" aria-hidden="true">{path.icon === 'novel' ? <><path d="M12 5c-3-2-7-2-10-1v15c3-1 7-1 10 1 3-2 7-2 10-1V4c-3-1-7-1-10 1Z"/><path d="M12 5v15"/></> : path.icon === 'screenplay' ? <><rect x="5" y="2" width="14" height="20" rx="2"/><path d="M9 7h6M9 11h6M9 15h3"/></> : <><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m10 8 6 4-6 4Z"/></>}</svg>
    <a class="docs-path-title" href={route(locale, 'docs/' + path.href)}><h2>{path.title}</h2><span aria-hidden="true">↗</span></a><p>{path.text}</p><nav aria-label={path.title}>{path.links.map(([title, id]) => <a href={route(locale, 'docs/' + id)}>{title}<span aria-hidden="true">→</span></a>)}</nav>
  </section>)}</div>
  <div class="docs-reading-note"><p>{en ? 'New to working with an Agent?' : '第一次和 Agent 一起创作？'} <a href={route(locale, 'docs/agents')}>{en ? 'See how the collaboration works' : '先了解怎样协作'} →</a></p><span>{m.docs.note}</span></div>
  {groups.map(group => <section class="guide-group" aria-labelledby={`guide-group-${group.id}`}><div class="guide-group-heading"><h2 id={`guide-group-${group.id}`}><a href={route(locale, sectionPath(group.id))}>{group.title[locale]} <span aria-hidden="true">→</span></a></h2><p>{sectionContent[group.id].description[locale]}</p></div><div class="doc-index">{orderedDocs.filter(doc => doc.group === group.id).map(doc => <a href={route(locale, `docs/${doc.id}`)}><div><b>{doc.title[locale]}</b><small>{doc.description[locale]}</small></div><span aria-hidden="true">→</span></a>)}</div></section>)}
</div>
