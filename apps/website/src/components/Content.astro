---
import {messages,route,prototype,type Locale} from '../lib/site';
interface Props{locale:Locale;page:string;}const {locale,page}=Astro.props;const m=messages(locale);
const tools=[['hetu_read_blueprint','设定集读取','Read Story Bible'],['hetu_write_draft','草稿提交','Submit a draft'],['hetu_extract_plot','剧情梳理','Extract plot beats'],['hetu_build_drama_skeleton','分集结构','Build scene structure'],['hetu_validate_blueprint','一致性检查','Validate consistency'],['hetu_commit_snapshot','受控版本快照','Prepare controlled snapshots'],['hetu_export_bundle','交付包导出','Export a delivery bundle'],['hetu_list_workspace','工作区查询','Inspect authorized workspace']];
---
<div class="container subpage">{page==='workflow'?<><header class="page-hero"><span class="eyebrow">{m.workflow.eyebrow}</span><h1>{m.workflow.title}</h1><p>{m.workflow.intro}</p></header><img class="subpage-illustration" src="/images/hero-workspace.webp" width="1536" height="1024" alt={m.hero.alt}/><div class="steps">{m.workflow.steps.map((s,i)=><article class="step"><span>0{i+1}</span><h2>{s.title}</h2><p>{s.body}</p></article>)}</div><section class="section"><h2>{m.workflow.detail}</h2><div class="principle-grid">{m.workflow.details.map(item=><article><h3>{item.title}</h3><p>{item.body}</p></article>)}</div></section><div class="page-cta"><a class="button primary" href={prototype(locale)}>{m.workspace.cta} ↗</a><a class="button" href={route(locale,'docs')}>{m.nav.docs} →</a></div></>:page==='integrations'?<><header class="page-hero"><span class="eyebrow">{m.integrations.eyebrow}</span><h1>{m.integrations.title}</h1><p>{m.integrations.intro}</p></header><div class="integration-layers">{m.integrations.layers.map((item,i)=><article><span>0{i+1}</span><div><h2>{item.title}</h2><p>{item.body}</p></div></article>)}</div><section class="section"><h2>{m.integrations.toolsTitle}</h2><div class="tool-list">{tools.map(([id,zh,en])=><div><code>{id}</code><span>{locale==='en'?en:zh}</span></div>)}</div><p class="image-caption">{m.integrations.status}</p></section><section class="manual-panel"><h2>{m.integrations.manual}</h2><p>{m.integrations.manualBody}</p><a class="text-link" href={route(locale,'docs/agents')}>{m.nav.docs} →</a></section></>:<><header class="page-hero"><span class="eyebrow">{m.faq.eyebrow}</span><h1>{m.faq.title}</h1></header><div class="faq-list">{m.faq.items.map((item,i)=><details open={i===0}><summary>{item.q}<span aria-hidden="true">+</span></summary><p>{item.a}</p></details>)}</div><div class="page-cta"><a class="button primary" href={route(locale,'docs')}>{m.hero.secondary} →</a></div></>}</div>
