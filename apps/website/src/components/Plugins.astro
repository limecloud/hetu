---
import Site from '../layouts/Site.astro';
import { type CreativePlugin } from '../lib/plugins';
import { route, type Locale } from '../lib/site';
import PluginCatalog from './PluginCatalog.astro';
import PluginVisual from './PluginVisual.astro';
interface Props { locale: Locale; plugin?: CreativePlugin; }
const { locale, plugin } = Astro.props;
const en = locale === 'en';
const title = plugin ? plugin.display[locale] : en ? 'Creative plugins' : '插件中心';
const description = plugin ? plugin.summary[locale] : en ? 'Add the creative tools your story needs. Let your Agent organize the work, then explore it in Hetu Luoshu.' : '按需扩展你的创作工作台。让 Agent 整理复杂结构，在河图里看清关系、顺序与每一次选择。';
---
<Site locale={locale} page={'plugins' + (plugin ? '/' + plugin.slug : '')} title={title} description={description}>
  <div class="container subpage plugins-page">
    {plugin ? <>
      <a class="text-link plugin-back" href={route(locale, 'plugins')}>← {en ? 'All creative plugins' : '全部创作插件'}</a>
      <header class="page-hero plugin-detail-hero"><div><h1>{title}</h1><p>{description}</p><p class="plugin-byline">{en ? 'By Hetu Luoshu' : '河图洛书出品'} <span>v{plugin.version}</span></p><a class="button primary" href={route(locale, 'docs/plugins')}>{en ? 'How to use this plugin' : '了解如何使用'} <span aria-hidden="true">→</span></a></div><PluginVisual locale={locale} kind={plugin.slug}/></header>
      <div class="plugin-detail-layout"><div>
        <section class="plugin-detail-section"><h2>{en ? 'A good fit for' : '适合什么创作问题'}</h2><p>{plugin.use[locale]}</p><p>{plugin.review[locale]}</p></section>
        <section class="plugin-detail-section"><h2>{en ? 'Give your Agent a concrete goal' : '向 Agent 说出具体目标'}</h2><blockquote data-plugin-request>{plugin.request[locale]}</blockquote><button class="button secondary" type="button" hidden data-copy-plugin-request data-done={en ? 'Request copied' : '已复制请求'} data-error={en ? 'Copy failed. Select the request above and copy it.' : '复制未成功，请选中上方请求手动复制。'}>{en ? 'Copy request' : '复制协作请求'}</button><p class="plugin-copy-status" role="status" data-plugin-copy-status></p><p>{en ? 'Use it in a connected conversation with the exact work and permissions. Copying a request does not send it or authorize an installation.' : '在已接入的对话中明确本次作品与允许范围。复制请求不会发送消息，也不会自动安装或授权。'}</p></section>
        <section class="plugin-detail-section"><h2>{en ? 'Keep the work, even when you stop using a tool' : '工具按需使用，成果持续保留'}</h2><p>{en ? 'Disable or uninstall the plugin when it is no longer useful. Saved creative data remains available through generic reading and export. New package versions require their own permission check.' : '不再需要时可以停用或卸载插件。已保存的专业成果仍可通过通用读取与导出保留；升级后的新包需要重新核验授权。'}</p></section>
      </div><aside class="plugin-package"><h2>{en ? 'Package information' : '插件包信息'}</h2><dl><div><dt>{en ? 'Version' : '版本'}</dt><dd>{plugin.version}</dd></div><div><dt>Host API</dt><dd>{plugin.host_api}</dd></div><div><dt>{en ? 'License' : '许可证'}</dt><dd>{plugin.license}</dd></div><div><dt>{en ? 'Package ID' : '插件标识'}</dt><dd><code>{plugin.id}</code></dd></div></dl><h3>{en ? 'Requested permissions' : '声明权限'}</h3><p>{en ? 'Read and save this plugin’s professional data within an authorized work. Installation alone grants no work access.' : '读取和保存获权作品中本插件的专业数据。安装本身不授予作品访问权。'}</p><ul>{plugin.permissions.map(permission => <li><code>{permission}</code></li>)}</ul><nav aria-label={en ? 'Package resources' : '插件资料'}><a href={plugin.source} rel="noreferrer">{en ? 'Source on GitHub' : '查看 GitHub 源码'} ↗</a><a href={plugin.capabilities} rel="noreferrer">{en ? 'Package capability list' : '查看包内功能清单'} ↗</a><a href={route(locale, 'docs/plugin-development')}>{en ? 'Build and validate packages' : '构建与校验插件包'} →</a></nav></aside></div>
    </> : <>
      <header class="page-hero plugin-center-hero"><h1>{en ? <>More ways to see.<br/>More room to create.</> : <>让创作的复杂，<br/>变成看得见的结构。</>}</h1><div><p>{description}</p><a class="text-link" href={route(locale, 'docs/plugins')}>{en ? 'Start with creative plugins' : '创作插件使用指南'} →</a></div></header>
      <PluginCatalog locale={locale}/>
      <section class="plugin-journey"><h2>{en ? 'You lead. Your tools adapt.' : '你掌握创作，工具配合你。'}</h2><ol>{(en ? [['Choose what helps', 'Start with your story’s problem. Add a relationship graph or timeline only when it helps you judge the work.'], ['Let your Agent organize', 'Your Agent discovers the installed tools, checks the permitted work and prepares a structure you can inspect.'], ['Review and continue', 'Read the result, point out what needs changing and continue from the saved version. You can also edit it yourself.']] : [['按问题选择', '从故事的实际难题出发。需要看清人物关系或事件顺序时，再添加相应工具。'], ['让 Agent 整理', 'Agent 发现已装工具，核对本次作品与允许范围，准备可审阅的结构。'], ['看清成果，再继续', '查看、提意见，沿已保存的版本继续调整。你也可以随时亲自编辑。']]).map(([heading, body], i) => <li><span>0{i + 1}</span><h3>{heading}</h3><p>{body}</p></li>)}</ol></section>
      <section class="plugin-boundaries"><div><h2>{en ? 'Creative tools live in Hetu.' : '创作工具，装在河图里。'}</h2><p>{en ? 'Hetu plugins add views, structured data and actions to your workspace. Skills and client integration packages give your external Agent methods and a connection. They work together, with separate installation and permissions.' : '河图插件扩展工作台的视图、专业数据和操作。Skills 与客户端接入包为外部 Agent 提供方法和连接。两者协作，分别安装、分别管理权限。'}</p><a class="text-link" href={route(locale, 'integrations')}>{en ? 'Connect your Agent' : '了解 Agent 接入与 Skills'} →</a></div><div><h2>{en ? 'Build for the way authors work.' : '把你的专业方法，做成创作工具。'}</h2><p>{en ? 'Use JavaScript or TypeScript, with React for views. Start from the scaffold, declare your data and permissions, validate a fixed package and propose a catalog entry through GitHub.' : '用 JavaScript 或 TypeScript 开发，视图可使用 React。从脚手架开始，声明数据与权限，校验固定包，再通过 GitHub 提交目录收录申请。'}</p><a class="text-link" href={route(locale, 'docs/plugin-development')}>{en ? 'Developer guide' : '插件开发指南'} →</a><a class="text-link" href={route(locale, 'docs/plugin-publishing')}>{en ? 'Publishing and listing' : '发布与上架指南'} →</a></div></section>
      <div class="plugin-reading"><a href={route(locale, 'blog/creative-plugins')}>{en ? 'Why a creative workspace needs plugins' : '为什么创作工作台需要插件？'} <span aria-hidden="true">→</span></a></div>
    </>}
  </div>
</Site>
<script>
  const button = document.querySelector<HTMLButtonElement>('[data-copy-plugin-request]');
  if (button) {
    button.hidden = false;
    button.addEventListener('click', async () => {
      const status = document.querySelector<HTMLElement>('[data-plugin-copy-status]')!;
      try { await navigator.clipboard.writeText(document.querySelector('[data-plugin-request]')!.textContent!.trim()); status.textContent = button.dataset.done!; }
      catch { status.textContent = button.dataset.error!; }
    });
  }
</script>
