---
import { prototype, type Locale } from '../lib/site';
import { assetURL } from '../lib/assets';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const en = locale === 'en';
const entries = [
  { title: en?'Hetu Luoshu wordmark':'河图洛书字标', body: en?'Transparent artwork for light and dark backgrounds, with English typography.':'中文优先与全英文两套字标，提供浅底、深底透明 PNG。', image:'/resources/brand/wordmark'+(en?'-en':'')+'.png' },
  { title: en?'A place for every book':'每一本书，都有自己的位置', body: en?'Our dragon-horse beside three independent books, a manuscript and river-inspired scrolls.':'小图、多部作品与河洛意象卷轴，共用无文字场景图。', image:'/images/hetu-luoshu-library-scene.webp' },
  { title: en?'Meet Xiaotu':'认识河图洛书小图', body: en?'Our little dragon-horse, in jade, warm ivory and cinnabar.':'玉青色小龙马，卷轴鬃毛与朱砂印章。', image:'/brand/mascot-master.png', href:'/brand/mascot-master.png', square:true },
  { title: en?'One identity, every platform':'同一个小图，陪伴不同平台', body: en?'macOS, Windows, iOS, Android and Web icons.':'macOS、Windows、iOS、Android 与 Web 图标资源。', image:'/resources/brand/icon-overview'+(en?'-en':'')+'.png', href:'/resources/manifest.json' },
  { title: en?'A workspace for your story':'为你的故事准备的工作台', body: en?'The current homepage library demo, using the native client’s layout and artwork.':'当前首页书库演示，复用原生布局与插画，点击即可在首页操作。', image:'/images/prototype-desktop'+(en?'-en':'')+'.webp', href:prototype(locale) },
  { title: en?'A mobile companion':'移动端的陪伴式体验', body: en?'iOS and Android visual concepts. Mobile apps are outside the V1 desktop scope.':'iOS／Android 查看与审核的视觉延展，不代表 V1 移动应用。', image:'/images/prototype-mobile'+(en?'-en':'')+'.webp' },
  { title: en?'A website in your language':'使用熟悉的语言认识河图洛书', body: en?'English copy, interface previews and sharing artwork.':'中文优先的页面、界面示意与分享图。', image:'/images/prototype-website'+(en?'-en':'')+'.webp' },
  { title: en?'A little company for your desk':'让小图陪你写下去', body: en?'Collectibles, notebooks, mugs and stickers with the Hetu Luoshu wordmark. Manufacturing artwork is separate.':'手办、笔记本、杯具与贴纸的品牌延展。量产需另行制作工艺文件。', image:'/images/brand-merch'+(en?'-en':'')+'.webp' },
  { title: en?'Share your story workspace':'分享你的故事工作台', body: en?'Localized social artwork at 1200 × 630 pixels.':'1200 × 630 分享图，中英文分别排版。', image:'/images/social-og'+(en?'-en':'')+'.png' },
];
---
<div class="container subpage"><header class="page-hero"><span class="eyebrow">HETU LUOSHU</span><h1>{en?'A companion for your story world.':'让故事世界，有一个可爱的模样。'}</h1><p>{en?'Brand artwork, platform icons and localized interface concepts. Artwork illustrates the product design; it does not represent released applications.':'品牌形象、跨平台图标与界面设计。图片展示产品设计，交互原型使用演示数据。'}</p></header>
<div class="brand-downloads"><a class="button secondary" href={assetURL('/resources/brand/wordmark'+(en?'-en':'')+'.png')} download>{en?'Wordmark, light':'浅底字标'} ↓</a><a class="button secondary" href={assetURL('/resources/brand/wordmark'+(en?'-en':'')+'-dark.png')} download>{en?'Wordmark, dark':'深底字标'} ↓</a><a class="button secondary" href={assetURL("/resources/brand/Hetu.icns")} download>macOS .icns ↓</a><a class="button secondary" href={assetURL("/resources/brand/hetu.ico")} download>Windows .ico ↓</a><a class="button secondary" href={assetURL("/brand/favicon.ico")} download>Web favicon ↓</a></div>
<div class="brand-gallery">{entries.map(entry=><article><a href={entry.href?.includes('#') ? entry.href : assetURL(entry.href || entry.image)}><div class:list={['brand-image',{'square':entry.square}]}><img src={assetURL(entry.image)} alt={entry.title} loading="lazy"/></div></a><h2>{entry.title}</h2><p>{entry.body}</p></article>)}</div></div>
