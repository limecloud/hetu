---
import {route,type Locale} from '../lib/site';
interface Props {locale:Locale;}
const {locale}=Astro.props;
const en=locale==='en';
const rows=en?[
  ['A quick idea','Ask your Agent directly. A name, a line of dialogue or a temporary draft can stay in the conversation.','No project required'],
  ['A question about your work','Find the passage, source or earlier decision. Read what is needed and answer with references.','Reading can be enough'],
  ['A work you will return to','Keep drafts, choices and feedback together. Compare the next revision and deliver the version you choose.','Continue in Hetu'],
]:[
  ['临时想一想','想几个名字、试一句对白，或改一份普通文件，直接使用熟悉的 Agent 即可。','不用先建作品'],
  ['查作品里的事','找一段原文、一条设定或先前的决定。按需读取，带着引用回答。','只读就能完成'],
  ['准备继续发展','接续长篇、修改分集、比较方案，或交出确定的一稿，让成果和意见围绕作品保留。','在河图接着做'],
];
---
<section class="section use-when" id="when-to-use" aria-labelledby="when-to-use-title">
  <div class="section-head"><div><h2 id="when-to-use-title">{en?'Use what your work needs.':'当前工具够用，就从那里继续。'}</h2><p>{en?'Hetu is useful when returning, comparing and revising become harder than generating another draft.':'当接续、核对和修改开始比生成一稿更费力时，河图才值得加入。'}</p></div></div>
  <dl>{rows.map(([title,body,result])=><div><dt>{title}</dt><dd>{body}</dd><dd class="use-when-result">{result}</dd></div>)}</dl>
  <a class="text-link" href={route(locale,'docs/when-to-use')}>{en?'Find the smallest useful starting point':'判断这次是否需要河图'} →</a>
</section>
<style>
.use-when dl { margin:24px 0; }
.use-when dl > div { display:grid; grid-template-columns:160px 1fr 160px; align-items:baseline; gap:24px; padding:20px 0; border-bottom:.5px solid var(--line); }
.use-when dt { font-weight:600; font-size:14px; }
.use-when dd { margin:0; color:var(--muted); font-size:14px; line-height:1.7; }
.use-when .use-when-result { text-align:right; }
@media(max-width:760px) { .use-when dl > div { grid-template-columns:1fr; gap:8px; } .use-when .use-when-result { text-align:left; font-size:12px; } }
</style>
