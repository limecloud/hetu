---
import { messages, route, source, prototype, version, type Locale } from '../lib/site';
import Workbench from './Workbench.astro';
import PluginVisual from './PluginVisual.astro';
import ShanhaiEntry from './ShanhaiEntry.astro';
import SkillsCatalog from './SkillsCatalog.astro';
import AgentEntrypoints from './AgentEntrypoints.astro';
import WorkflowShowcase from './WorkflowShowcase.astro';
import AuthorPrinciple from './AuthorPrinciple.astro';
import CreativeResults from './CreativeResults.astro';
import RevisionExperience from './RevisionExperience.astro';
import ProjectLayers from './ProjectLayers.astro';
import CreativeRoutes from './CreativeRoutes.astro';
import MarketEvidence from './MarketEvidence.astro';
import { positioning } from '../lib/positioning';
import { evidence } from '../lib/market';
import { articles, articleImage } from '../lib/journal';
import { assetURL } from '../lib/assets';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const m = messages(locale);
const p = positioning(locale);
const en = locale === 'en';
---
<section class="hero-stage">
  <picture class="hero-backdrop">
    <source media="(max-width: 760px)" srcset={assetURL('/images/hetu-river-background-mobile.webp')}/>
    <img class="hero-art" src={assetURL('/images/hetu-river-background.webp')} width="1672" height="941" alt={m.hero.alt} fetchpriority="high"/>
  </picture>
  <div class="container hero">
    <div class="hero-copy">
      <h1>{m.hero.line1}<br/><em>{en?m.hero.line2:<><span class="hero-phrase">看见它的</span><wbr/><span class="hero-phrase">下一种表达。</span></>}</em></h1>
      <p class="hero-description">{en?'Start a novel, a script or a short video. Your Agent creates. You read, watch and shape what comes next.':'从小说、剧本或短视频开始。让熟悉的 Agent 推进，回河图阅读、观看与取舍。'}</p>
      <a class="hero-author-voice" href="#author-values">{en?'Your taste and creative judgment lead the way.':'品味、判断与创意，始终由你掌握。'}</a>
      <nav class="hero-protocols" aria-label={en?'Connect your Agent':'连接你的 Agent'}>
        <a href={route(locale,'docs/agents')+'#mcp'}>MCP ↗</a>
        <a href={route(locale,'docs/agents')+'#cli'}>CLI ↗</a>
        <a href={route(locale,'integrations')+'#skills-catalog'}>Skills ↗</a>
      </nav>
      <div class="hero-actions">
        <a class="button primary" href={prototype(locale)}>{locale==='en'?'Explore the workspace':'查看创作工作台'}<span aria-hidden="true">↗</span></a>
        <a class="button secondary" href={route(locale,'docs/install')}>{en?'Download Hetu':'下载桌面版'}<span aria-hidden="true">→</span></a>
      </div>
      <p class="hero-note">{m.hero.note}</p>
    </div>
  </div>
</section>
<div class="container">
  <section class="section results-section" aria-label={en?'Explore original creative examples':'查看原创创作示例'}><CreativeResults locale={locale}/></section>
  <div class="hero-market-signal">
    <p><strong>{en?evidence.global.downloads_q1_2025.display:evidence.china.drama_users.display}</strong><span>{en?'global short-drama app downloads / Q1 2025':'中国微短剧用户 / 2025年12月'}</span></p>
    <a class="text-link" href="#market-evidence">{en?'See the evidence and scope':'查看数据与口径'} ↓</a>
    <p class="hero-agent-signal">{en?'Agent-friendly software':'AI 友好的创作软件'}<strong>MCP / CLI / Skills</strong></p>
  </div>
  <CreativeRoutes locale={locale}/>
  <WorkflowShowcase locale={locale}/>
  <RevisionExperience locale={locale}/>
  <section class="section workspace-section" id="prototype">
    <div class="section-head">
      <div><h2>{m.workspace.title}</h2></div>
      <span class="demo-version">v{version} / Electron</span>
    </div>
    <p class="section-intro">{m.workspace.body}</p>
    <Workbench locale={locale}/>
  </section>
  <ProjectLayers locale={locale}/>
  <AuthorPrinciple locale={locale}/>
  <section class="section plugin-home">
    <div class="plugin-home-grid"><div><h2>{en ? 'A workspace that grows with your story.' : '作品越深入，工具越贴合。'}</h2><p>{en ? 'Explore a growing cast as a relationship graph. Trace events on a story timeline. Add the tools you need, let your Agent organize the structure and keep your attention on the creative choices.' : '人物多了，用关系图看清彼此牵连；时间复杂了，用时间线核对事件顺序。按需添加工具，让 Agent 整理结构，把注意力留给创作判断。'}</p><div class="plugin-home-links"><a class="text-link" href={route(locale, 'plugins')}>{en ? 'Explore creative plugins' : '探索创作插件'} →</a><a class="text-link" href={route(locale, 'docs/plugin-development')}>{en ? 'Build a plugin' : '开发你的插件'} →</a></div></div><PluginVisual locale={locale}/></div>
  </section>
  <ShanhaiEntry locale={locale}/>
  <SkillsCatalog locale={locale} compact/>
  <AgentEntrypoints locale={locale}/>
  <MarketEvidence locale={locale}/>
  <section class="section home-questions">
    <div class="section-head"><div><h2>{p.questionsTitle}</h2></div></div>
    <div class="faq-list">{p.questions.map(([q,a])=><details><summary>{q}<span aria-hidden="true">+</span></summary><p>{a}</p></details>)}</div>
  </section>
  <section class="section home-journal">
    <div class="section-head"><div><h2>{en?'Ideas behind the workspace':'从创作者的困惑，读懂河图。'}</h2></div><a class="text-link" href={route(locale,'blog')}>{p.readMore} →</a></div>
    <div class="journal-list">{articles.slice(0, 3).map(article=><a href={route(locale,'blog/'+article.id)}><img class="journal-cover" src={assetURL(articleImage(article,locale))} width="768" height="432" alt="" loading="lazy"/><h3>{article.titles[locale]}</h3><p>{article.descriptions[locale]}</p><span class="text-link">{en?'Read article':'阅读全文'} →</span></a>)}</div>
  </section>
  <section class="closing-section">
    <div class="closing-copy"><img src={assetURL("/brand/mascot-master.png")} width="160" height="160" alt="" loading="lazy"/><div><h2>{m.open.title}</h2><p>{m.open.body}</p></div></div>
    <div class="closing-links"><a class="button secondary" href={route(locale,'docs/getting-started')}>{locale==='en'?'Start your next project':'开始你的下一部作品'} <span aria-hidden="true">→</span></a><a class="text-link" href={source} rel="noreferrer">{m.open.cta} <span aria-hidden="true">↗</span></a></div>
  </section>
</div>
