---
import type { Locale } from '../lib/site';
import '../styles/plugins.css';
interface Props { locale: Locale; kind?: string; }
const { locale, kind = 'relationships' } = Astro.props;
const en = locale === 'en';
const captures: Record<string, { width: number; height: number; zh: string; en: string }> = {
  'book-export': {"width": 1360, "height": 900, "zh": "书稿交付实际工作面，macOS正式安装版与隔离演示资料。", "en": "Book Export actual work surface with the official macOS installation and isolated demonstration data."},

  'readthrough': {"width": 1360, "height": 996, "zh": "朗读审阅实际工作面，macOS正式安装版与隔离演示资料。", "en": "Readthrough actual work surface with the official macOS installation and isolated demonstration data."},

  'story-translation': {"width": 1360, "height": 900, "zh": "译稿工坊实际工作面，macOS正式安装版与隔离演示资料。", "en": "Story Translation actual work surface with the official macOS installation and isolated demonstration data."},

  'series-organizer': {"width": 1360, "height": 900, "zh": "系列组织实际工作面，macOS正式安装版与隔离演示资料。", "en": "Series Organizer actual work surface with the official macOS installation and isolated demonstration data."},

  'interactive-fiction': {"width": 1360, "height": 900, "zh": "互动叙事实际工作面，macOS正式安装版与隔离演示资料。", "en": "Interactive Fiction actual work surface with the official macOS installation and isolated demonstration data."},

  'lorebook-bridge': {"width": 1360, "height": 917, "zh": "世界书互通实际工作面，macOS正式安装版与隔离演示资料。", "en": "Lorebook Bridge actual work surface with the official macOS installation and isolated demonstration data."},

  'story-research': { width:1360, height:900, zh:'创作研究台的问题、固定来源与研究结论，使用演示资料。', en:'Story Research questions, fixed sources and conclusions with demonstration data.' },
  'character-lab': { width:1360, height:900, zh:'人物工坊的侧写与动机工作面，使用演示资料。', en:'Character Lab profiles and motivations with demonstration data.' },
  'story-analysis': { width:1360, height:900, zh:'故事分析的结构、覆盖与问题依据，使用演示资料。', en:'Story Analysis structure, coverage and findings with demonstration data.' },
  'prose-studio': {width:1345,height:1343,zh:'文风工坊按本次人物和场景选择偏好，使用演示资料。',en:'Prose Studio selecting preferences for the current character and scene with demonstration data.'},
  'novel-review': {width:1345,height:1058,zh:'小说审校的固定规则运行、问题依据与缺失前提，使用演示资料。',en:'Novel Review fixed rule runs, findings and missing premises with demonstration data.'},
  'novel-atlas': {width:1345,height:1222,zh:'小说图鉴的地点示意、人物行程与未知位置，使用演示资料。',en:'Novel Atlas places, character routes and unknown positions with demonstration data.'},
  shanhai: { width: 1440, height: 960, zh: '山海经纬插件中阅读原创档案故事，使用隔离演示资料。', en: 'Reading an original archive story in Shanhai with isolated demonstration data.' },
  'novel-planner': { width: 1345, height: 1053, zh: '小说规划展示明确事件偏序、时距及固定依据，使用演示资料。', en: 'Novel Planner showing explicit event order, time intervals and fixed evidence with demonstration data.' },
  screenplay: { width: 1440, height: 960, zh: '剧本创作的人物关系与伏笔工作面，使用演示资料。', en: 'Screenplay relationships and clues with demonstration data.' },
  'video-studio': { width: 1440, height: 960, zh: '视听制作的固定剪辑版本与时间映射，使用演示资料。', en: 'Video Studio edit versions and time mappings with demonstration data.' },
  'director-stage': { width: 1440, height: 1000, zh: '导演布景台的俯视调度、三维取景与四镜头台词表，使用演示资料。', en: 'Director Stage showing a floor plan, actual 3D preview and four-shot dialogue table with demonstration data.' },
};
const capture = captures[kind];
---
<figure class:list={['plugin-visual', `visual-${kind}`]}>
  {capture ? <img src={`/plugins/${kind}.png`} width={capture.width} height={capture.height} loading="lazy" alt={en ? capture.en : capture.zh}/> : kind === 'relationships' ? <svg viewBox="0 0 360 240" role="img" aria-label={en ? 'Example: Lin and Qiao are siblings, and both know Zhou.' : '示例：林舟与林乔为兄妹，两人分别与周远相识。'}>
    <path class="graph-link" d="M85 65H275 M85 65L180 180 M275 65L180 180"/>
    <g class="graph-label"><text x="180" y="51">{en ? 'Siblings' : '兄妹'}</text><text x="85" y="143">{en ? 'Old friend' : '旧友'}</text><text x="275" y="143">{en ? 'Colleagues' : '同事'}</text></g>
    {[{ x: 85, y: 65, label: en ? 'Lin' : '林舟' }, { x: 275, y: 65, label: en ? 'Qiao' : '林乔' }, { x: 180, y: 180, label: en ? 'Zhou' : '周远' }].map(n => <g class="graph-node"><rect x={n.x - 48} y={n.y - 22} width="96" height="44" rx="6"/><text x={n.x} y={n.y} dominant-baseline="middle">{n.label}</text></g>)}
  </svg> : <div class="timeline-visual"><ol>
    <li><span>{en ? 'Day 1 / Morning' : '第一天 早晨'}</span><strong>{en ? 'The watchmaker returns' : '修表师回到故乡'}</strong></li>
    <li><span>{en ? 'Day 1 / Night' : '第一天 深夜'}</span><strong>{en ? 'A letter in the old clock' : '旧钟里藏着一封信'}</strong></li>
    <li><span>{en ? 'Day 2 / Dawn' : '第二天 黎明'}</span><strong>{en ? 'An unexpected visitor' : '意料之外的来访者'}</strong></li>
  </ol></div>}
  <figcaption>{capture ? (en ? 'Hetu plugin with demonstration data' : '河图插件工作面 演示资料') : (en ? 'Creative structure example' : '创作结构示意')}</figcaption>
</figure>
