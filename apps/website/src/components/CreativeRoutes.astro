---
import { route, type Locale } from '../lib/site';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const en = locale === 'en';
const items = en ? [
  ['A novel worth reading', 'Begin with a character, a premise or a manuscript. Read the chapters. Shape the next draft.', 'writing', 'Write a novel'],
  ['A script ready to perform', 'Start with an original idea or a chosen source. Review the action, dialogue and dramatic turns.', 'screenplays', 'Develop a script'],
  ['A story told on screen', 'Bring an idea, a storyboard or existing clips. Watch, leave a note and refine the cut.', 'video', 'Make a short video'],
] : [
  ['写成值得读的小说', '从人物、构思或已有原稿开始，连贯阅读章节，推敲下一版。', 'writing', '开始小说创作'],
  ['写成可以演的剧本', '从原创构思或选定原著出发，审阅行动、对白与戏剧转折。', 'screenplays', '开始剧本创作'],
  ['让故事在画面中发生', '带着创意、分镜或已有片段开始，观看、提意见，再打磨节奏。', 'video', '开始短视频创作'],
];
---
<section class="section creative-routes" id="creative-routes">
  <div class="section-head"><div><h2>{en ? 'Start with the work you actually have.' : '你从哪里开始，河图就从哪里连接。'}</h2></div></div>
  <p class="section-intro">{en ? 'Your creative library holds independent novels, scripts and videos. Start with any of them.' : '创作库中的小说、剧本与视频各自独立，从你想做的那一种开始。'}</p>
  <div class="creative-route-grid">{items.map(([title, body, target, label]) => <article><h3>{title}</h3><p>{body}</p><a class="text-link" href={route(locale, 'docs/' + target)}>{label}<span aria-hidden="true">→</span></a></article>)}</div>
  <div class="creative-route-related"><span>{en?'Already have a source?':'已有作品？'}</span><a href={route(locale,'docs/import-manuscript')}>{en?'Import a manuscript':'导入原稿'} ↗</a><a href={route(locale,'docs/adaptation')}>{en?'Adapt a chosen source':'改编已有作品'} ↗</a><a href={route(locale,'docs/creative-paths')}>{en?'Sources and permissions':'来源与授权'} ↗</a></div>
</section>
