---
import {messages,route,origin,source,prototype,version,type Locale} from '../lib/site';
import { assetURL } from '../lib/assets';
import '../styles/global.css';
import '../styles/foundation.css';
import '../styles/pages.css';
import '../styles/docs.css';
interface Props{locale:Locale;page?:string;title?:string;description?:string;noindex?:boolean;socialImage?:{path:string;width:number;height:number;alt:string};}
const {locale,page='',title,description,noindex=false,socialImage}=Astro.props;
const m=messages(locale), canonical=new URL(page==='404'?'/404.html':route(locale,page),origin).href;
const localePage=page==='404'?'':page;
const name=title?`${title} — ${locale==='en'?'Hetu Luoshu':'河图洛书 Hetu Luoshu'}`:m.meta.title;
const desc=description??m.meta.description;
const shareImage=origin+(socialImage?.path??assetURL('/images/social-og'+(locale==='en'?'-en':'')+'.png'));
const nav=[['',m.nav.product],['workflow',m.nav.workflow],['plugins',m.nav.plugins],['integrations',m.nav.integrations],['docs',m.nav.docs],['blog',locale==='en'?'Journal':'创作与改编']];
const jsonld={'@context':'https://schema.org','@graph':[{'@type':'WebSite','@id':origin+'/#website',name:'河图洛书 Hetu Luoshu',url:origin,inLanguage:['zh-CN','en']},{'@type':'WebPage',name,url:canonical,description:desc,inLanguage:locale,isPartOf:{'@id':origin+'/#website'}}]};
---
<!doctype html><html lang={locale}><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{name}</title><meta name="description" content={desc}/><meta name="theme-color" content="#fbfdfc"/><meta name="robots" content={noindex?'noindex,follow':'index,follow'}/><link rel="canonical" href={canonical}/><link rel="alternate" hreflang="zh-CN" href={new URL(route('zh-CN',localePage),origin).href}/><link rel="alternate" hreflang="en" href={new URL(route('en',localePage),origin).href}/><link rel="alternate" hreflang="x-default" href={new URL(route('zh-CN',localePage),origin).href}/><link rel="icon" type="image/x-icon" href={assetURL("/brand/favicon.ico")}/><link rel="icon" type="image/png" sizes="32x32" href={assetURL("/brand/icon-32.png")}/><link rel="apple-touch-icon" sizes="180x180" href={assetURL("/brand/icon-180.png")}/><link rel="manifest" href={assetURL(locale==='en'?'/brand/manifest-en.webmanifest':'/brand/manifest.webmanifest')}/><meta property="og:type" content="website"/><meta property="og:site_name" content="河图洛书 Hetu Luoshu"/><meta property="og:title" content={name}/><meta property="og:description" content={desc}/><meta property="og:url" content={canonical}/><meta property="og:locale" content={locale==='en'?'en_US':'zh_CN'}/><meta property="og:image" content={shareImage}/><meta property="og:image:width" content={String(socialImage?.width??1200)}/><meta property="og:image:height" content={String(socialImage?.height??630)}/><meta property="og:image:alt" content={socialImage?.alt??m.meta.title}/><meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={name}/><meta name="twitter:description" content={desc}/><meta name="twitter:image" content={shareImage}/><script type="application/ld+json" set:html={JSON.stringify(jsonld).replaceAll('<','\\u003c')}/></head><body class:list={{'home-page':page==='', 'content-page':page!=='', 'docs-page':page==='docs'||page.startsWith('docs/')}}>
<a class="skip-link" href="#main">{m.nav.skip}</a><header class="site-nav"><a class="brand" href={route(locale)} aria-label={locale==='en'?'Hetu Luoshu home':'河图洛书首页'}><img src={assetURL("/brand/app-icon-1024.png")} width="42" height="42" alt=""/><span>{locale==='en'?'Hetu Luoshu':<>河图洛书 <small>Hetu Luoshu</small></>}</span></a><nav class="desktop-nav" aria-label={m.nav.menu}>{nav.map(([id,label])=><a href={route(locale,id)} aria-current={page===id||page.startsWith(id+'/')?'page':undefined}>{label}</a>)}</nav><div class="header-actions"><a class="source-link" href={route(locale,'console')}>{m.cloud.nav}</a><a class="lang" href={route(locale==='en'?'zh-CN':'en',localePage)} lang={locale==='en'?'zh-CN':'en'} aria-label={m.nav.language}>{locale==='en'?'中文':'EN'}</a><a class="source-link" href={source} rel="noreferrer">GitHub <span aria-hidden="true">↗</span></a><details class="mobile-nav"><summary aria-label={m.nav.menu}><span></span><span></span></summary><nav aria-label={m.nav.menu}>{nav.map(([id,label])=><a href={route(locale,id)}>{label}</a>)}<a href={route(locale,'console')}>{m.cloud.nav}</a><a href={route(locale,'faq')}>{m.nav.faq}</a></nav></details></div></header>
<main id="main"><slot/></main><footer class="site-footer"><div class="container"><div class="footer-main"><div><a class="brand" href={route(locale)}><img src={assetURL("/brand/icon-64.png")} width="36" height="36" alt=""/><span>{locale==='en'?'Hetu Luoshu':<>河图洛书 <small>Hetu Luoshu</small></>}</span></a><p>{m.footer.description}</p><p class="status-note">v{version} / {m.footer.status}</p></div><nav aria-label={locale==='en'?'Footer':'页尾导航'}><a href={route(locale,'workflow')}>{m.nav.workflow}</a><a href={route(locale,'integrations')}>{m.nav.integrations}</a><a href={route(locale,'plugins')}>{m.nav.plugins}</a><a href="https://shanhai.limeai.run/">{locale==='en'?'Shanhai templates':'山海创作模板'} ↗</a><a href={route(locale,'docs')}>{m.nav.docs}</a><a href={route(locale,'faq')}>{m.nav.faq}</a><a href={route(locale,'blog')}>{locale==='en'?'Journal':'创作与改编'}</a><a href={prototype(locale)}>{m.footer.design}</a><a href={route(locale,'console')}>{m.cloud.nav}</a><a href={route(locale,'brand')}>{locale==='en'?'Brand & design':'品牌与设计'}</a><a href={source} rel="noreferrer">GitHub ↗</a></nav></div><div class="footer-bottom"><span>© {new Date().getUTCFullYear()} {locale==='en'?'Hetu Luoshu':'河图洛书 Hetu Luoshu'} / Apache-2.0</span><a href="/llms.txt">llms.txt</a></div><p class="privacy-note">{m.footer.privacy}</p></div></footer>
<script>document.addEventListener('keydown',event=>{if(event.key==='Escape')document.querySelectorAll<HTMLDetailsElement>('.mobile-nav[open]').forEach(d=>{d.open=false;d.querySelector<HTMLElement>('summary')?.focus();});});document.addEventListener('click',event=>{document.querySelectorAll<HTMLDetailsElement>('.mobile-nav[open]').forEach(d=>{if(event.target instanceof Node&&!d.contains(event.target))d.open=false;});});</script>
</body></html>
