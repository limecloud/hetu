---
import {messages,route,origin,source,prototype,type Locale} from '../lib/site';
import '../styles/global.css';
interface Props{locale:Locale;page?:string;title?:string;description?:string;noindex?:boolean;}
const {locale,page='',title,description,noindex=false}=Astro.props;
const m=messages(locale), canonical=new URL(route(locale,page),origin).href;
const name=title?`${title} — ${locale==='en'?'Hetu Luoshu':'河图洛书 Hetu Luoshu'}`:m.meta.title;
const desc=description??m.meta.description;
const shareImage=origin+'/images/social-og'+(locale==='en'?'-en':'')+'.png';
const nav=[['',m.nav.product],['workflow',m.nav.workflow],['integrations',m.nav.integrations],['docs',m.nav.docs]];
const jsonld={'@context':'https://schema.org','@graph':[{'@type':'WebSite','@id':origin+'/#website',name:'河图洛书 Hetu Luoshu',url:origin,inLanguage:['zh-CN','en']},{'@type':'WebPage',name,url:canonical,description:desc,inLanguage:locale,isPartOf:{'@id':origin+'/#website'}}]};
---
<!doctype html><html lang={locale}><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{name}</title><meta name="description" content={desc}/><meta name="theme-color" content="#f8f6ef"/><meta name="robots" content={noindex?'noindex,follow':'index,follow'}/><link rel="canonical" href={canonical}/><link rel="alternate" hreflang="zh-CN" href={new URL(route('zh-CN',page),origin).href}/><link rel="alternate" hreflang="en" href={new URL(route('en',page),origin).href}/><link rel="alternate" hreflang="x-default" href={new URL(route('zh-CN',page),origin).href}/><link rel="icon" type="image/x-icon" href="/brand/favicon.ico"/><link rel="icon" type="image/png" sizes="32x32" href="/brand/icon-32.png"/><link rel="apple-touch-icon" sizes="180x180" href="/brand/icon-180.png"/><link rel="manifest" href={locale==='en'?'/brand/manifest-en.webmanifest':'/brand/manifest.webmanifest'}/><meta property="og:type" content="website"/><meta property="og:site_name" content="河图洛书 Hetu Luoshu"/><meta property="og:title" content={name}/><meta property="og:description" content={desc}/><meta property="og:url" content={canonical}/><meta property="og:locale" content={locale==='en'?'en_US':'zh_CN'}/><meta property="og:image" content={shareImage}/><meta property="og:image:width" content="1200"/><meta property="og:image:height" content="630"/><meta property="og:image:alt" content={locale==='en'?'Hetu Luoshu — A clear foundation. Room to create.':'河图洛书 Hetu Luoshu — 设定有据，创作有序'}/><meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={name}/><meta name="twitter:description" content={desc}/><meta name="twitter:image" content={shareImage}/><script type="application/ld+json" set:html={JSON.stringify(jsonld).replaceAll('<','\\u003c')}/></head><body>
<a class="skip-link" href="#main">{m.nav.skip}</a><header class="site-nav"><a class="brand" href={route(locale)} aria-label={locale==='en'?'Hetu Luoshu home':'河图洛书首页'}><img src="/brand/app-icon-1024.png" width="42" height="42" alt=""/><span>{locale==='en'?'Hetu Luoshu':<>河图洛书 <small>Hetu Luoshu</small></>}</span></a><nav class="desktop-nav" aria-label={m.nav.menu}>{nav.map(([id,label])=><a href={route(locale,id)} aria-current={page===id||id==='docs'&&page.startsWith('docs/')?'page':undefined}>{label}</a>)}</nav><div class="header-actions"><a class="lang" href={route(locale==='en'?'zh-CN':'en',page)} lang={locale==='en'?'zh-CN':'en'} aria-label={m.nav.language}>{locale==='en'?'中文':'EN'}</a><a class="source-link" href={source} rel="noreferrer">GitHub <span aria-hidden="true">↗</span></a><details class="mobile-nav"><summary aria-label={m.nav.menu}><span></span><span></span></summary><nav aria-label={m.nav.menu}>{nav.map(([id,label])=><a href={route(locale,id)}>{label}</a>)}<a href={route(locale,'faq')}>{m.nav.faq}</a></nav></details></div></header>
<main id="main"><slot/></main><footer class="site-footer"><div class="container"><div class="footer-main"><div><a class="brand" href={route(locale)}><img src="/brand/icon-64.png" width="36" height="36" alt=""/><span>{locale==='en'?'Hetu Luoshu':<>河图洛书 <small>Hetu Luoshu</small></>}</span></a><p>{m.footer.description}</p><p class="status-note">{m.footer.status}</p></div><nav aria-label={locale==='en'?'Footer':'页尾导航'}><a href={route(locale,'workflow')}>{m.nav.workflow}</a><a href={route(locale,'integrations')}>{m.nav.integrations}</a><a href={route(locale,'docs')}>{m.nav.docs}</a><a href={route(locale,'faq')}>{m.nav.faq}</a><a href={prototype(locale)}>{m.footer.design}</a><a href={route(locale,'brand')}>{locale==='en'?'Brand & design':'品牌与设计'}</a><a href={source} rel="noreferrer">GitHub ↗</a></nav></div><div class="footer-bottom"><span>© {new Date().getUTCFullYear()} {locale==='en'?'Hetu Luoshu':'河图洛书 Hetu Luoshu'} · Apache-2.0</span><a href="/llms.txt">llms.txt</a></div><p class="privacy-note">{m.footer.privacy}</p></div></footer>
<script>document.addEventListener('keydown',event=>{if(event.key==='Escape')document.querySelectorAll<HTMLDetailsElement>('.mobile-nav[open]').forEach(d=>{d.open=false;d.querySelector<HTMLElement>('summary')?.focus();});});document.addEventListener('click',event=>{document.querySelectorAll<HTMLDetailsElement>('.mobile-nav[open]').forEach(d=>{if(event.target instanceof Node&&!d.contains(event.target))d.open=false;});});</script>
</body></html>
