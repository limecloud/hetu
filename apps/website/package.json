{
  "name": "@hetu/website",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "assets": "node scripts/prepare-assets.mjs",
    "dev": "npm run assets && astro dev --host 127.0.0.1 --port 4350",
    "check": "astro check",
    "build": "npm run assets && astro check && astro build && node scripts/verify-build.mjs",
    "preview": "astro preview --host 127.0.0.1 --port 4351",
    "deploy": "npm run build && wrangler pages deploy dist --project-name hetu-website --branch main",
    "test": "playwright test"
  },
  "dependencies": {
    "astro": "7.4.2",
    "marked": "17.0.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "typescript": "6.0.3",
    "wrangler": "4.156.0"
  }
}
