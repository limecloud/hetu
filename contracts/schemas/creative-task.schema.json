{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hetu.limeai.run/schemas/creative-task.schema.json",
  "$defs": {
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "revision",
        "sha256"
      ]
    },
    "scope_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "creation_project",
            "workspace"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        }
      },
      "required": [
        "kind",
        "id"
      ]
    },
    "task_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scope_ref": {
          "$ref": "#/$defs/scope_ref"
        },
        "task_id": {
          "type": "string",
          "pattern": "^task_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "request_revision": {
          "const": 1
        }
      },
      "required": [
        "scope_ref",
        "task_id",
        "request_revision"
      ]
    },
    "candidate_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "task_ref": {
          "$ref": "#/$defs/task_ref"
        },
        "submission_id": {
          "type": "string",
          "pattern": "^submission_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "candidate_id": {
          "type": "string",
          "pattern": "^candidate_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        }
      },
      "required": [
        "task_ref",
        "submission_id",
        "candidate_id"
      ]
    },
    "selected_field": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "value": {
          "type": "string",
          "minLength": 0,
          "maxLength": 100000
        },
        "candidate_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/candidate_ref"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "value",
        "candidate_ref"
      ]
    },
    "selected_fields": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "$ref": "#/$defs/selected_field"
        },
        "author_name": {
          "$ref": "#/$defs/selected_field"
        },
        "synopsis": {
          "$ref": "#/$defs/selected_field"
        },
        "genre": {
          "$ref": "#/$defs/selected_field"
        },
        "outline": {
          "$ref": "#/$defs/selected_field"
        }
      },
      "required": []
    },
    "project_get_input": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "project_id": {
          "type": "string",
          "pattern": "^project_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "project_id"
      ]
    },
    "project_save_input": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "project_id": {
          "type": "string",
          "pattern": "^project_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "expected": {
          "$ref": "#/$defs/expected"
        },
        "brief": {
          "type": "string",
          "minLength": 0,
          "maxLength": 20000
        },
        "selected_fields": {
          "$ref": "#/$defs/selected_fields"
        },
        "operation_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "project_id",
        "expected",
        "brief",
        "selected_fields",
        "operation_key"
      ]
    },
    "creation_source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "project_id": {
          "type": "string",
          "pattern": "^project_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "project_revision": {
          "type": "integer",
          "minimum": 1
        },
        "project_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "selected_fields": {
          "$ref": "#/$defs/selected_fields"
        },
        "candidate_snapshots": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "reference": {
                "$ref": "#/$defs/candidate_ref"
              },
              "kind": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "content": {
                "type": "string",
                "minLength": 0,
                "maxLength": 100000
              }
            },
            "required": [
              "reference",
              "kind",
              "sha256",
              "content"
            ]
          },
          "minItems": 0,
          "maxItems": 16
        }
      },
      "required": [
        "project_id",
        "project_revision",
        "project_sha256",
        "selected_fields",
        "candidate_snapshots"
      ]
    },
    "create_novel_input": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "project_id": {
          "type": "string",
          "pattern": "^project_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "expected": {
          "$ref": "#/$defs/expected"
        },
        "metadata": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "author_name": {
              "type": "string",
              "minLength": 0,
              "maxLength": 200
            },
            "synopsis": {
              "type": "string",
              "minLength": 0,
              "maxLength": 20000
            },
            "genre": {
              "type": "string",
              "minLength": 0,
              "maxLength": 100
            },
            "language_tag": {
              "type": "string",
              "minLength": 2,
              "maxLength": 64
            },
            "status": {
              "enum": [
                "planning",
                "writing",
                "completed",
                "archived"
              ]
            }
          },
          "required": [
            "title",
            "author_name",
            "synopsis",
            "genre",
            "language_tag",
            "status"
          ]
        },
        "target_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "operation_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "project_id",
        "expected",
        "metadata",
        "target_path",
        "operation_key"
      ]
    },
    "source_ref": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "document"
            },
            "document_id": {
              "type": "string",
              "pattern": "^doc_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "revision_id": {
              "type": "string",
              "pattern": "^rev_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            }
          },
          "required": [
            "kind",
            "document_id",
            "revision_id"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "blueprint"
            },
            "revision": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "kind",
            "revision"
          ]
        }
      ]
    },
    "range": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "byte_start": {
          "type": "integer",
          "minimum": 0
        },
        "byte_end": {
          "type": "integer",
          "minimum": 0
        },
        "quote": {
          "type": "string",
          "minLength": 0,
          "maxLength": 1048576
        }
      },
      "required": [
        "byte_start",
        "byte_end",
        "quote"
      ]
    },
    "edit_scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "document_id": {
          "type": "string",
          "pattern": "^doc_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "revision_id": {
          "type": "string",
          "pattern": "^rev_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "ranges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/range"
          },
          "minItems": 1,
          "maxItems": 16
        }
      },
      "required": [
        "document_id",
        "revision_id",
        "ranges"
      ]
    },
    "patch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "byte_start": {
          "type": "integer",
          "minimum": 0
        },
        "byte_end": {
          "type": "integer",
          "minimum": 0
        },
        "quote": {
          "type": "string",
          "minLength": 0,
          "maxLength": 1048576
        },
        "replacement": {
          "type": "string",
          "minLength": 0,
          "maxLength": 1048576
        }
      },
      "required": [
        "byte_start",
        "byte_end",
        "quote",
        "replacement"
      ]
    },
    "preview_input": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scope_ref": {
          "$ref": "#/$defs/scope_ref"
        },
        "task_kind": {
          "enum": [
            "book_concept",
            "book_profile",
            "outline",
            "cover",
            "chapter_draft",
            "revision",
            "drama_draft"
          ]
        },
        "brief": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        },
        "input_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source_ref"
          },
          "minItems": 0,
          "maxItems": 8
        },
        "client_adapter": {
          "enum": [
            "codex",
            "workbuddy",
            "claude-code",
            "other"
          ]
        },
        "language_tag": {
          "enum": [
            "zh-CN",
            "en"
          ]
        },
        "candidate_limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "edit_scope": {
          "$ref": "#/$defs/edit_scope"
        }
      },
      "required": [
        "scope_ref",
        "task_kind",
        "brief",
        "input_refs",
        "client_adapter",
        "language_tag"
      ]
    },
    "prepare_input": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scope_ref": {
          "$ref": "#/$defs/scope_ref"
        },
        "task_kind": {
          "enum": [
            "book_concept",
            "book_profile",
            "outline",
            "cover",
            "chapter_draft",
            "revision",
            "drama_draft"
          ]
        },
        "brief": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        },
        "input_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source_ref"
          },
          "minItems": 0,
          "maxItems": 8
        },
        "client_adapter": {
          "enum": [
            "codex",
            "workbuddy",
            "claude-code",
            "other"
          ]
        },
        "language_tag": {
          "enum": [
            "zh-CN",
            "en"
          ]
        },
        "candidate_limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "edit_scope": {
          "$ref": "#/$defs/edit_scope"
        },
        "task_id": {
          "type": "string",
          "pattern": "^task_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "expected_scope": {
          "$ref": "#/$defs/expected"
        },
        "prompt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200000
        },
        "operation_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "scope_ref",
        "task_kind",
        "brief",
        "input_refs",
        "client_adapter",
        "language_tag",
        "task_id",
        "expected_scope",
        "prompt",
        "operation_key"
      ]
    },
    "get_input": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "task_ref": {
          "$ref": "#/$defs/task_ref"
        },
        "submission_id": {
          "type": "string",
          "pattern": "^submission_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        }
      },
      "required": [
        "task_ref"
      ]
    },
    "list_input": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "state": {
          "enum": [
            "ready",
            "waiting_for_result",
            "result_received",
            "partial_result",
            "closed"
          ]
        },
        "cursor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      },
      "required": []
    },
    "candidate_input": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "concept",
            "title",
            "synopsis",
            "outline",
            "text",
            "image"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "source_format": {
          "enum": [
            "plain",
            "markdown",
            "fountain",
            "image"
          ]
        },
        "source_ref_indices": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 7
          },
          "maxItems": 8
        },
        "content": {
          "type": "string",
          "minLength": 0,
          "maxLength": 1048576
        },
        "file_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[^/\\\\\\x00]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "patches": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/patch"
          },
          "minItems": 1,
          "maxItems": 64
        }
      },
      "required": [
        "kind",
        "title",
        "source_format",
        "source_ref_indices"
      ],
      "oneOf": [
        {
          "required": [
            "content"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "file_name"
                ]
              },
              {
                "required": [
                  "patches"
                ]
              }
            ]
          }
        },
        {
          "required": [
            "file_name",
            "sha256"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "content"
                ]
              },
              {
                "required": [
                  "patches"
                ]
              }
            ]
          }
        },
        {
          "required": [
            "patches"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "content"
                ]
              },
              {
                "required": [
                  "file_name"
                ]
              }
            ]
          }
        }
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "client": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "skill_version": {
          "type": "string",
          "minLength": 0,
          "maxLength": 100
        },
        "model": {
          "type": "string",
          "minLength": 0,
          "maxLength": 200
        },
        "notes": {
          "type": "string",
          "minLength": 0,
          "maxLength": 2000
        }
      },
      "required": [
        "client",
        "skill_version"
      ]
    },
    "submit_input": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "task_ref": {
          "$ref": "#/$defs/task_ref"
        },
        "request_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "candidates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/candidate_input"
          },
          "minItems": 1,
          "maxItems": 4
        },
        "complete": {
          "type": "boolean"
        },
        "missing_items": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "minItems": 0,
          "maxItems": 16
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "operation_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "task_ref",
        "request_sha256",
        "candidates",
        "complete",
        "missing_items",
        "provenance",
        "operation_key"
      ]
    },
    "inspect_input": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "task_ref": {
          "$ref": "#/$defs/task_ref"
        },
        "file_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[^/\\\\\\x00]+$"
        },
        "operation_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "task_ref",
        "file_name",
        "operation_key",
        "manifest_sha256"
      ]
    },
    "close_input": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "task_ref": {
          "$ref": "#/$defs/task_ref"
        },
        "expected": {
          "$ref": "#/$defs/expected"
        },
        "reason": {
          "type": "string",
          "minLength": 0,
          "maxLength": 2000
        },
        "operation_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "task_ref",
        "expected",
        "reason",
        "operation_key"
      ]
    },
    "copy_input": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "task_ref": {
          "$ref": "#/$defs/task_ref"
        },
        "request_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "operation_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "task_ref",
        "request_sha256",
        "operation_key"
      ]
    },
    "interaction_get_input": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "task_ref": {
          "$ref": "#/$defs/task_ref"
        }
      },
      "required": [
        "task_ref"
      ]
    },
    "selection_input": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "task_ref": {
          "$ref": "#/$defs/task_ref"
        },
        "expected": {
          "$ref": "#/$defs/expected"
        },
        "candidate_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/candidate_ref"
          },
          "minItems": 0,
          "maxItems": 4
        },
        "comment": {
          "type": "string",
          "minLength": 0,
          "maxLength": 4000
        },
        "operation_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "task_ref",
        "expected",
        "candidate_refs",
        "comment",
        "operation_key"
      ]
    },
    "submission_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "submission_id": {
          "type": "string",
          "pattern": "^submission_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "submission_id",
        "sha256"
      ]
    },
    "decision_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "decision_id": {
          "type": "string",
