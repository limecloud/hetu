{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hetu.limeai.run/schemas/novel.schema.json",
  "$ref": "#/$defs/novel",
  "$defs": {
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "author_name": {
          "type": "string",
          "minLength": 0,
          "maxLength": 200
        },
        "synopsis": {
          "type": "string",
          "minLength": 0,
          "maxLength": 20000
        },
        "genre": {
          "type": "string",
          "minLength": 0,
          "maxLength": 100
        },
        "language_tag": {
          "type": "string",
          "minLength": 2,
          "maxLength": 64
        },
        "status": {
          "enum": [
            "planning",
            "writing",
            "completed",
            "archived"
          ]
        }
      },
      "required": [
        "title",
        "author_name",
        "synopsis",
        "genre",
        "language_tag",
        "status"
      ]
    },
    "volume": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "volume_id": {
          "type": "string",
          "pattern": "^volume_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "required": [
        "volume_id",
        "title"
      ]
    },
    "chapter": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "chapter_id": {
          "type": "string",
          "pattern": "^chapter_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "document_id": {
          "type": "string",
          "pattern": "^doc_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "volume_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^volume_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "chapter_id",
        "document_id",
        "volume_id"
      ]
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "revision",
        "sha256"
      ]
    },
    "novel": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "workspace_id": {
          "type": "string",
          "pattern": "^workspace_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "novel_id": {
          "type": "string",
          "pattern": "^novel_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "previous_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "metadata": {
          "$ref": "#/$defs/metadata"
        },
        "volumes": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "$ref": "#/$defs/volume"
          }
        },
        "chapters": {
          "type": "array",
          "maxItems": 100000,
          "items": {
            "$ref": "#/$defs/chapter"
          }
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "schema_version",
        "workspace_id",
        "novel_id",
        "revision",
        "previous_sha256",
        "metadata",
        "volumes",
        "chapters",
        "created_at",
        "updated_at"
      ]
    },
    "get_input": {
      "type": "object",
      "additionalProperties": false,
      "properties": {},
      "required": []
    },
    "initialize_input": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "metadata": {
          "$ref": "#/$defs/metadata"
        },
        "operation_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "metadata",
        "operation_key"
      ]
    },
    "update_input": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "expected": {
          "$ref": "#/$defs/expected"
        },
        "metadata": {
          "$ref": "#/$defs/metadata"
        },
        "operation_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "expected",
        "metadata",
        "operation_key"
      ]
    },
    "structure_input": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "expected": {
          "$ref": "#/$defs/expected"
        },
        "volumes": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "$ref": "#/$defs/volume"
          }
        },
        "chapters": {
          "type": "array",
          "maxItems": 100000,
          "items": {
            "$ref": "#/$defs/chapter"
          }
        },
        "operation_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "expected",
        "volumes",
        "chapters",
        "operation_key"
      ]
    }
  }
}
