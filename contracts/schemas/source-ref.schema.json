{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HetuSourceRef",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "document_id",
    "revision_id",
    "byte_start",
    "byte_end",
    "quote"
  ],
  "properties": {
    "document_id": {
      "type": "string",
      "pattern": "^doc_[0-9a-f-]{36}$"
    },
    "revision_id": {
      "type": "string",
      "pattern": "^rev_[0-9a-f-]{36}$"
    },
    "byte_start": {
      "type": "integer",
      "minimum": 0
    },
    "byte_end": {
      "type": "integer",
      "minimum": 0
    },
    "quote": {
      "type": "string"
    }
  }
}
