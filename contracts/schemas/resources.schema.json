{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HetuResources",
  "$defs": {
    "record": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "workspace_id": {
          "type": "string",
          "pattern": "^workspace_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "resource_id": {
          "type": "string",
          "pattern": "^resource_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "previous_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "title": {
          "type": "string",
          "maxLength": 200,
          "minLength": 1
        },
        "category": {
          "enum": [
            "character",
            "location",
            "prop",
            "research",
            "artwork",
            "media"
          ]
        },
        "body": {
          "type": "string",
          "maxLength": 1000000,
          "minLength": 0
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1
          },
          "maxItems": 50,
          "uniqueItems": true
        },
        "project_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^drama_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "entity_refs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "kind": {
                "enum": [
                  "character",
                  "location",
                  "faction",
                  "event",
                  "world"
                ]
              },
              "entity_id": {
                "type": "string",
                "maxLength": 100,
                "minLength": 1
              },
              "blueprint_revision": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "blueprint_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "kind",
              "entity_id",
              "blueprint_revision",
              "blueprint_sha256"
            ]
          },
          "maxItems": 50,
          "uniqueItems": true
        },
        "source_notes": {
          "type": "string",
          "maxLength": 20000,
          "minLength": 0
        },
        "state": {
          "enum": [
            "draft",
            "adopted",
            "archived"
          ]
        },
        "owner_task_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^task_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "created_at": {
          "type": "string",
          "maxLength": 64,
          "minLength": 1
        },
        "updated_at": {
          "type": "string",
          "maxLength": 64,
          "minLength": 1
        },
        "actor_ref": {
          "type": "string",
          "pattern": "^actor_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
