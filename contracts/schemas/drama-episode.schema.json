{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HetuDramaEpisode",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "workspace_id": {
      "type": "string",
      "pattern": "^workspace_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "previous_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "created_at": {
      "type": "string",
      "maxLength": 64,
      "minLength": 1
    },
    "updated_at": {
      "type": "string",
      "maxLength": 64,
      "minLength": 1
    },
    "actor_ref": {
      "type": "string",
      "pattern": "^actor_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "episode_id": {
      "type": "string",
      "pattern": "^depisode_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "project_id": {
      "type": "string",
      "pattern": "^drama_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "title": {
      "type": "string",
      "maxLength": 200,
      "minLength": 1
    },
    "plan": {
      "type": "string",
      "maxLength": 20000,
      "minLength": 0
    },
    "document_id": {
      "type": "string",
      "pattern": "^doc_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "archived": {
      "type": "boolean"
    }
  },
  "required": [
    "schema_version",
    "workspace_id",
    "revision",
    "previous_sha256",
    "created_at",
    "updated_at",
    "actor_ref",
    "episode_id",
    "project_id",
    "title",
    "plan",
    "document_id",
    "archived"
  ]
}
