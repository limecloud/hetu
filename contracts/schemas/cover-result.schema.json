{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HetuCoverResult",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "workspace_id", "request_id", "request_sha256", "completed_at", "candidates"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "workspace_id": {"type": "string", "pattern": "^workspace_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "request_id": {"type": "string", "pattern": "^cover_request_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "request_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "completed_at": {"type": "string", "format": "date-time"},
    "candidates": {
      "type": "array", "minItems": 1, "maxItems": 4,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["filename", "sha256", "size_bytes", "width", "height", "media_type", "used_prompt", "generator"],
        "properties": {
          "filename": {"type": "string", "pattern": "^candidate-[0-9]{2}\\.(png|jpg|webp)$"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "size_bytes": {"type": "integer", "minimum": 1, "maximum": 33554432},
          "width": {"type": "integer", "minimum": 64, "maximum": 8192},
          "height": {"type": "integer", "minimum": 64, "maximum": 8192},
          "media_type": {"enum": ["image/png", "image/jpeg", "image/webp"]},
          "used_prompt": {"type": "string", "minLength": 1, "maxLength": 16000},
          "generator": {
            "type": "object", "additionalProperties": false,
            "required": ["agent", "tool"],
            "properties": {
              "agent": {"type": "string", "minLength": 1, "maxLength": 200},
              "tool": {"type": "string", "minLength": 1, "maxLength": 200},
              "model": {"type": "string", "minLength": 1, "maxLength": 200}
            }
          }
        }
      }
    }
  }
}
