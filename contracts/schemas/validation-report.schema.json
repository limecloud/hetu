              "required_references",
              "story_time",
              "fact_assertions",
              "applicable_facts",
              "location",
              "plot_nodes",
              "story_order_edges",
              "scope_text_coverage",
              "source_scan"
            ]
          },
          "maxItems": 100
        },
        "disposition": {
          "const": "open"
        },
        "exception_policy": {
          "enum": [
            "none",
            "author_review"
          ]
        }
      },
      "required": [
        "finding_id",
        "rule_id",
        "rule_revision",
        "severity",
        "certainty",
        "message_key",
        "source_refs",
        "blueprint_refs",
        "evidence",
        "missing_prerequisites",
        "disposition",
        "exception_policy"
      ]
    },
    "input_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "plot_revision_id": {
          "type": "string",
          "pattern": "^plotrev_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "plot_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "blueprint_revision": {
          "type": "integer",
          "minimum": 1
        },
        "blueprint_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "source_revisions": {
          "type": "array",
          "items": {
            "$ref": "urn:hetu:schema:plot:1.0.0#/$defs/source_revision"
          },
          "maxItems": 32
        }
      },
      "required": [
        "plot_revision_id",
        "plot_sha256",
        "blueprint_revision",
        "blueprint_sha256",
        "source_revisions"
      ]
    }
  }
