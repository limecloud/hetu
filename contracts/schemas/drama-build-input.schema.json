{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "plot_revision_id": {
      "type": "string",
      "pattern": "^plotrev_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "blueprint_revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "episode_options": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "episode_start_node_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^node_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "minItems": 0,
          "maxItems": 500,
          "uniqueItems": true
        }
      },
      "required": []
    },
    "operation_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    }
  },
  "required": [
    "plot_revision_id",
    "blueprint_revision",
    "episode_options",
    "operation_key"
  ]
}
