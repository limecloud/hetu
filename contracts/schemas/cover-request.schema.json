{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HetuCoverRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "workspace_id", "request_id", "book", "design", "prompt", "output_relative_dir", "created_at"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "workspace_id": {"type": "string", "pattern": "^workspace_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "request_id": {"type": "string", "pattern": "^cover_request_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "book": {
      "type": "object", "additionalProperties": false,
      "required": ["title", "author_name", "synopsis", "language_tag"],
      "properties": {
        "title": {"type": "string", "minLength": 1, "maxLength": 200},
        "author_name": {"type": "string", "maxLength": 200},
        "synopsis": {"type": "string", "maxLength": 4000},
        "language_tag": {"type": "string", "minLength": 2, "maxLength": 64}
      }
    },
    "design": {
      "type": "object", "additionalProperties": false,
      "required": ["art_direction", "width", "height", "text_mode", "cover_language", "candidate_count"],
      "properties": {
        "art_direction": {"type": "string", "minLength": 1, "maxLength": 4000},
        "width": {"type": "integer", "minimum": 64, "maximum": 8192},
        "height": {"type": "integer", "minimum": 64, "maximum": 8192},
        "text_mode": {"enum": ["background_only", "title_and_author"]},
        "cover_language": {"type": "string", "minLength": 2, "maxLength": 64},
        "candidate_count": {"type": "integer", "minimum": 1, "maximum": 4}
      }
    },
    "prompt": {"type": "string", "minLength": 1, "maxLength": 16000},
    "output_relative_dir": {"type": "string", "pattern": "^packages/visual-prompt/covers/inbox/cover_request_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "created_at": {"type": "string", "format": "date-time"}
  }
}
