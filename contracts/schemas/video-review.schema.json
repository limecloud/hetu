{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hetu.limeai.run/schemas/video-review.schema.json",
  "title": "HetuVideoReview",
  "$defs": {
    "asset_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "asset_id": {
          "type": "string",
          "pattern": "^asset_[0-9a-f-]{36}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "asset_id",
        "revision",
        "sha256"
      ]
    },
    "media_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "media_id": {
          "type": "string",
          "pattern": "^vmedia_[0-9a-f-]{36}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "media_id",
        "revision",
        "sha256"
      ]
    },
    "time_base": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "numerator": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "denominator": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "numerator",
        "denominator"
      ]
    },
    "media_save_input": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "work_ref": {
          "$ref": "https://hetu.limeai.run/schemas/work.schema.json#/$defs/work_ref"
        },
        "video_episode_id": {
          "type": "string",
          "pattern": "^vepisode_[0-9a-f-]{36}$"
        },
        "asset_ref": {
          "$ref": "#/$defs/asset_ref"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "purpose": {
          "enum": [
            "previsualization",
            "clip",
            "final"
          ]
        },
        "stream_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "time_base": {
          "$ref": "#/$defs/time_base"
        },
        "duration_ticks": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "previous_media_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/media_ref"
            },
            {
              "type": "null"
            }
          ]
        },
        "operation_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "required": [
        "work_ref",
        "video_episode_id",
        "asset_ref",
        "title",
        "purpose",
        "stream_index",
        "time_base",
        "duration_ticks",
        "operation_key"
      ]
    },
    "media_get_input": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "work_ref": {
          "$ref": "https://hetu.limeai.run/schemas/work.schema.json#/$defs/work_ref"
        },
        "media_ref": {
          "$ref": "#/$defs/media_ref"
        }
      },
      "required": [
        "work_ref",
        "media_ref"
      ]
    },
    "media_list_input": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "work_ref": {
          "$ref": "https://hetu.limeai.run/schemas/work.schema.json#/$defs/work_ref"
        },
        "video_episode_id": {
          "type": "string",
          "pattern": "^vepisode_[0-9a-f-]{36}$"
        },
        "cursor": {
          "type": "string",
          "maxLength": 200
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 25
        }
      },
      "required": [
        "work_ref",
        "video_episode_id"
      ]
    },
    "feedback_save_input": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "work_ref": {
          "$ref": "https://hetu.limeai.run/schemas/work.schema.json#/$defs/work_ref"
        },
        "media_ref": {
          "$ref": "#/$defs/media_ref"
        },
        "comment": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "range": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "start_tick": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "end_tick": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "start_tick",
                "end_tick"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "operation_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "required": [
        "work_ref",
        "media_ref",
        "comment",
        "operation_key"
      ]
    },
    "feedback_list_input": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "work_ref": {
          "$ref": "https://hetu.limeai.run/schemas/work.schema.json#/$defs/work_ref"
        },
        "media_ref": {
          "$ref": "#/$defs/media_ref"
        },
        "cursor": {
          "type": "string",
          "maxLength": 200
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 25
        }
      },
      "required": [
        "work_ref",
        "media_ref"
      ]
    },
    "delivery_preview_input": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "work_ref": {
          "$ref": "https://hetu.limeai.run/schemas/work.schema.json#/$defs/work_ref"
        },
        "media_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/media_ref"
          }
        }
      },
      "required": [
        "work_ref",
        "media_refs"
      ]
    },
    "asset_read_input": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "work_ref": {
          "$ref": "https://hetu.limeai.run/schemas/work.schema.json#/$defs/work_ref"
        },
        "asset_ref": {
          "$ref": "#/$defs/asset_ref"
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "length": {
          "type": "integer",
          "minimum": 1,
          "maximum": 524288
        }
      },
      "required": [
        "work_ref",
        "asset_ref",
        "offset",
        "length"
      ]
    }
  }
}
