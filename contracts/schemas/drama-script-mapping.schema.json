{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HetuDramaScriptMapping",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "renderer_version": {
      "const": "hetu-fountain-structure/1"
    },
    "document_id": {
      "type": "string",
      "pattern": "^doc_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "revision_id": {
      "type": "string",
      "pattern": "^rev_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "content_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "skeleton_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "skeleton_id": {
          "type": "string",
          "pattern": "^skeleton_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "skeleton_id",
        "revision",
        "sha256"
      ]
    },
    "language_tag": {
      "enum": [
        "zh-CN",
        "en"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "coverage_status": {
      "enum": [
        "complete",
        "partial"
      ]
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "episode_id": {
            "type": "string",
            "pattern": "^episode_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "scene_id": {
            "type": "string",
            "pattern": "^scene_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "episode_number": {
            "type": "integer",
            "minimum": 1
          },
          "scene_number": {
            "type": "integer",
            "minimum": 1
          },
          "byte_start": {
            "type": "integer",
            "minimum": 0
          },
          "byte_end": {
            "type": "integer",
            "minimum": 1
          },
          "quote": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "episode_id",
          "scene_id",
          "episode_number",
          "scene_number",
          "byte_start",
          "byte_end",
          "quote"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "renderer_version",
    "document_id",
    "revision_id",
    "content_sha256",
    "skeleton_ref",
    "language_tag",
    "title",
    "coverage_status",
    "scenes"
  ]
}
