{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HetuDramaProject",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "2.0.0"
    },
    "workspace_id": {
      "type": "string",
      "pattern": "^workspace_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "previous_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "created_at": {
      "type": "string",
      "maxLength": 64,
      "minLength": 1
    },
    "updated_at": {
      "type": "string",
      "maxLength": 64,
      "minLength": 1
    },
    "actor_ref": {
      "type": "string",
      "pattern": "^actor_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "project_id": {
      "type": "string",
      "pattern": "^drama_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "title": {
      "type": "string",
      "maxLength": 200,
      "minLength": 1
    },
    "description": {
      "type": "string",
      "maxLength": 20000,
      "minLength": 0
    },
    "mode": {
      "enum": [
        "original",
        "adaptation"
      ]
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "document_id": {
            "type": "string",
            "pattern": "^doc_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "revision_id": {
            "type": "string",
            "pattern": "^rev_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "document_id",
          "revision_id",
          "sha256"
        ]
      },
      "maxItems": 1000,
      "uniqueItems": true
    },
    "skeleton_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^skeleton_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
      },
      "maxItems": 10000,
      "uniqueItems": true
    },
    "episode_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^depisode_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
      },
      "maxItems": 10000,
      "uniqueItems": true
    },
    "archived": {
      "type": "boolean"
    }
  },
  "required": [
    "schema_version",
    "workspace_id",
    "revision",
    "previous_sha256",
    "created_at",
    "updated_at",
    "actor_ref",
    "project_id",
    "title",
    "description",
    "mode",
    "source_refs",
    "skeleton_ids",
    "episode_refs",
    "archived"
  ]
}
