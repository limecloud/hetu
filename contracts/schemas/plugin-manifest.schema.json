{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "host_api",
    "id",
    "version",
    "display",
    "description",
    "license",
    "dependencies",
    "contributions"
  ],
  "properties": {
    "work_kinds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": { "enum": ["novel", "drama", "video"] }
    },
    "manifest_version": {
      "const": 1
    },
    "host_api": {
      "const": "1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+(\\.[a-z0-9-]+)+$",
      "maxLength": 120
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "display": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "zh-CN",
        "en"
      ],
      "properties": {
        "zh-CN": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "en": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      }
    },
    "description": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "zh-CN",
        "en"
      ],
      "properties": {
        "zh-CN": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "en": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      }
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "dependencies": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "version"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+(\\.[a-z0-9-]+)+$",
            "maxLength": 120
          },
          "version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
          }
        }
      }
    },
    "permissions": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 3,
      "items": {
        "enum": [
          "objects.read",
          "objects.write",
          "work.read"
        ]
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entry"
      ],
      "properties": {
        "entry": {
          "type": "string",
          "minLength": 1,
          "maxLength": 250
        }
      }
    },
    "contributions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "views",
        "data",
        "actions"
      ],
      "properties": {
        "skills": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "name", "description", "entry"],
            "properties": {
              "id": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 64},
              "name": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 64},
              "description": {"type": "string", "minLength": 1, "maxLength": 1024},
              "entry": {"type": "string", "minLength": 1, "maxLength": 250}
            }
          }
        },
        "views": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "title",
              "entry",
              "object_kinds"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 250
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 250
              },
              "entry": {
                "type": "string",
                "minLength": 1,
                "maxLength": 250
              },
              "object_kinds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 250
                }
              },
              "navigation": {
                "type": "string",
                "enum": ["host", "integrated"]
              }
            }
          }
        },
        "data": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "schema_version",
              "schema"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "schema_version": {
                "type": "string",
                "minLength": 1,
                "maxLength": 250
              },
              "schema": {
                "type": "object"
              }
            }
          }
        },
        "actions": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "title",
              "input_schema",
              "effect"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 250
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 250
              },
              "input_schema": {
                "type": "object"
              },
              "effect": {
                "enum": [
                  "read",
                  "managed_write"
                ]
              }
            }
          }
        }
      }
    }
  }
}
