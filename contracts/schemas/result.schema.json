{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hetu:schema:result:1.0.0",
  "title": "Hetu AXI result envelope",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "spec_version": {"const":"0.2.1"},
    "kind": {"const":"result"},
    "action": {"type":"string","pattern":"^hetu\\.[a-z_]+\\.[a-z_]+$"},
    "contract_revision": {"const":"1"},
    "status": {"enum":["succeeded","partial","pending","blocked","failed","unknown"]},
    "context": {"type":"object","additionalProperties":false,"properties":{"scope_id":{"type":"string","pattern":"^(workspace|project)_[0-9a-f-]{36}$"}},"required":["scope_id"]},
    "data": {"type":"object","description":"Action-specific domain payload; governed by that action's contract."},
    "error": {
      "type":"object","additionalProperties":false,
      "properties": {
        "code":{"type":"string","minLength":1},
        "message":{"type":"string","minLength":1},
        "resolution":{"type":"object","additionalProperties":false,"properties":{"kind":{"enum":["read","request_decision","recover","correct_input"]},"action":{"type":"string"}},"required":["kind"]}
      },"required":["code","message","resolution"]
    },
    "operation": {
      "type":"object","additionalProperties":false,
      "properties":{"id":{"type":"string","pattern":"^op_[0-9a-f-]{36}$"},"key":{"type":"string","minLength":1,"maxLength":128},"input_digest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"recover_action":{"const":"hetu.operations.get"}},
      "required":["id","key","input_digest","recover_action"]
    }
  },
  "required":["spec_version","kind","action","contract_revision","status","context"],
  "allOf":[
    {"if":{"properties":{"status":{"enum":["succeeded","partial","pending"]}}},"then":{"required":["data"],"not":{"required":["error"]}},"else":{"required":["error"],"not":{"required":["data"]}}}
  ]
}
