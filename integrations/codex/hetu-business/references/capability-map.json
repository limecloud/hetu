{
  "schema_version": "1.0.0",
  "meaning": "source_wired仅表示源码合同和入口已连线；不证明安装、运行、跨平台或端到端通过。执行时先inspect实际能力。",
  "discovery": "hetu.collaboration.inspect",
  "map_action": "hetu.capabilities.map",
  "mcp_map_tool": "hetu_get_capability_map",
  "query": {
    "filters": [
      "group",
      "action",
      "skill"
    ],
    "pagination": [
      "offset",
      "limit"
    ],
    "include_schema": false
  },
  "workflows": [
    {
      "goal": "导入已有小说",
      "skill": "hetu-import",
      "entry": "hetu.import_authorizations.register",
      "path": [
        "发现能力及精确作品",
        "核对原稿、完整目录和摘要",
        "登记真实导入指令",
        "固定分批方案并执行",
        "逐篇回读及原键恢复"
      ]
    },
    {
      "goal": "整理资料、目录、设定或执行作者取舍",
      "skill": "hetu-manage",
      "entry": "hetu.agent_operations.catalog",
      "path": [
        "读取对象及固定修订",
        "按领域Schema准备方案",
        "展示差异并记录真实决定",
        "原Agent执行",
        "回读领域结果"
      ]
    },
    {
      "goal": "起草、改稿或整理大纲",
      "skill": "hetu-setup",
      "entry": "hetu.creative_tasks.list",
      "path": [
        "恢复已有任务或准备确切新任务",
        "按任务类型选择写作Skill",
        "按需读取固定上下文",
        "提交参考成果",
        "阅读反馈并沿原任务继续"
      ]
    },
    {
      "goal": "剧本复盘、全剧分集规划与场次创作",
      "skill": "hetu-drama",
      "entry": "hetu.drama.projects.get",
      "path": [
        "新作先独立筹备；已有作品读取确切项目、分集及固定正文",
        "区分作者稿、候选、旧大纲及原著阅读覆盖",
        "全剧→分集→场次；专业规划按实际插件能力保存",
        "固定Fountain任务起草、意见及同任务返工",
        "分集入口回读正文与来源；采纳后增量更新，完整范围单独验收"
      ]
    },
    {
      "goal": "短剧视频全季规划、制作与返工交付",
      "skill": "hetu-video",
      "entry": "hetu.video.projects.get",
      "path": [
        "独立筹备或恢复确切项目与原操作",
        "复盘剧本、已选素材、旧工程及实际观看覆盖",
        "全季→分集→分镜与资产；专业数据按实际插件合同保存",
        "按问题预演并固定代表性生成与预算，未知查原提供方任务",
        "剪辑音画→固定区间意见→局部返工→逐集成片与可恢复工程"
      ]
    },
    {
      "goal": "设置偏好或安装所选Skills套件",
      "skill": "hetu-manage",
      "entry": "hetu.local_settings.get",
      "path": [
        "读取本机基线",
        "准备固定设置方案",
        "记录真实选择",
        "精确市场预检后执行；未知沿原键只读恢复",
        "分别核对安装和本会话加载状态"
      ]
    },
    {
      "goal": "配置模型渠道",
      "skill": "hetu-manage",
      "entry": "hetu.model_settings.inspect",
      "path": [
        "读取非敏感设置及摘要",
        "按真实指令提交固定设置",
        "凭据仅进入私密存储",
        "回读非敏感结果；生成与费用另行授权"
      ]
    },
    {
      "goal": "安装、启停或卸载插件",
      "skill": "hetu-manage",
      "entry": "hetu.plugins.inspect",
      "path": [
        "核对包内容及摘要",
        "核对依赖和状态基线",
        "提交真实安装选择",
        "回读原操作",
        "启用后发现公开核心及插件能力"
      ]
    },
    {
      "goal": "使用插件及接续数据迁移",
      "skill": "hetu-manage",
      "entry": "hetu.plugins.capabilities",
      "path": [
        "读取活动包与作品连接",
        "发现核心和专业动作Schema",
        "固定输入及原键执行",
        "迁移固定前后内容和CAS",
        "回读原操作及成果"
      ]
    },
    {
      "goal": "发现并按需读取插件Skill",
      "skill": "hetu-setup",
      "entry": "hetu.plugins.inspect",
      "path": [
        "列出活动插件方法摘要",
        "按精确作品发现skills及resource_actions",
        "通过invoke的skills.read读取同包方法与引用",
        "按实际Schema执行并回读；停用或升级后重查"
      ]
    },
    {
      "goal": "保存文稿版本",
      "skill": "hetu-manage",
      "entry": "hetu.git.status",
      "path": [
        "读取本作品HEAD",
        "准备固定文稿快照",
        "审阅完整差异及提交身份",
        "记录确切snapshot决定",
        "执行并沿原snapshot和键回读"
      ]
    },
    {
      "goal": "导出文稿或交付包",
      "skill": "hetu-manage",
      "entry": "hetu.documents.preview_export",
      "path": [
        "读取确切修订及交付目标",
        "准备固定交付方案",
        "记录真实决定",
        "执行并核验文件和摘要"
      ]
    }
  ],
