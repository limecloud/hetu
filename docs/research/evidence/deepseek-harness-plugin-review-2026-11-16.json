  "findings": [
    {
      "mechanism": "组合与依赖",
      "source": "docs/architecture.md",
      "observation": "Cordis Context注册服务、事件与可撤销effects；配置层组合profile与bundle，依赖决定就绪顺序。",
      "hetu": "清单声明依赖与视图/动作/数据贡献；Rust只持有领域事务与确定性权限。"
    },
    {
      "mechanism": "生命周期串行化",
      "source": "packages/extensions/cordis-client-runner/src/client/runtime.ts",
      "observation": "按插件串行load/unload，固定package及run身份，卸载释放loader项、factory与样式。",
      "closed_gap": "宿主enable遇到异步依赖时可与disable/replace交错；补齐依赖图过渡队列。",
      "resolution": "依赖图共享过渡队列；并发启用、停用、替换及卸载的回归检查通过。"
    },
    {
      "mechanism": "Host与Client分工",
      "source": "packages/extensions/cordis-client-runner/src/client/orchestrator.ts",
      "observation": "Host激活先于Client加载，同一插件状态持有进行中的批准和错误。",
      "hetu": "第三方Client使用隔离WebContentsView，后端受管Node；不复制Agent循环。"
    },
    {
      "mechanism": "生态来源",
      "source": "apps/plugin-market-generator/src/sources.ts",
      "observation": "索引接收npm包和HTTPS Git来源并去重；条目数量不证明兼容或经过审核。",
      "hetu": "当前交付预构建固定包与创建/校验开发工具，生态分发另行验收。"
    }
  ],
